# ============================================================
# DAINEKU — Required Environment Variables
# Set ALL of these in Vercel: Settings → Environment Variables
# ============================================================

# Supabase — get from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare R2 — get from: dash.cloudflare.com → R2 → your bucket → Manage R2 API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=jdm-photos
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Admin — set to a long random string, this is your admin panel URL path
# Access admin at: yourdomain.com/[ADMIN_SECRET_PATH]
ADMIN_SECRET_PATH=change-this-to-a-long-random-string

# Canonical site URL (sitemap, canonical tags, metadataBase)
NEXT_PUBLIC_SITE_URL=https://daineku.com

# Studio contact. All server-side; read per request (redeploy on Vercel after changing env).
# CONTACT_EMAIL: public address shown on the homepage + mailto fallback. Never use a placeholder in production.
CONTACT_EMAIL=
# Optional inbox for enquiries; defaults to CONTACT_EMAIL.
CONTACT_TO_EMAIL=
# Server-side enquiry delivery via Resend (resend.com). Both required to enable it.
# CONTACT_FROM_EMAIL must be on a domain verified in Resend, e.g. "DAINEKU <studio@daineku.com>".
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Support module (Patreon) — OPTIONAL. Disabled unless a real patreon.com creator page is configured.
# Preferred: admin → Site Settings → Support module (needs supabase/migration_v11a_support_module.sql).
# Fallback when that migration has not been applied: configure it here (redeploy to apply).
# PATREON_URL=https://www.patreon.com/your-creator-page
# SUPPORT_TITLE=
# SUPPORT_BODY=
# SUPPORT_CTA=
# SUPPORT_PROJECT=thekanjo
# SUPPORT_PLACEMENT=project   # project | home
# SUPPORT_IMAGE_URL=
# SUPPORT_IMAGE_ALT=

# TEST ONLY — used by the Playwright smoke suite to point a built app at tests/mock-backend.mjs.
# Never set these in Vercel or any real environment.
# SUPABASE_URL_OVERRIDE=
# R2_ENDPOINT=

# Optional: turn off turbopack if you see build issues
# NEXT_TURBOPACK=0
